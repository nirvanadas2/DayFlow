PORT=5000
MONGO_URI=mongodb://localhost:27017/dayflow
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Email alerts (Phase 8) — optional in dev. Leave SMTP_HOST unset to skip
# sending and just log to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Dayflow <no-reply@dayflow.local>
